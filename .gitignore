# =============================================================================
# .gitignore — Yaazhi GeoAlign OS / SIH26166
# Copyright (c) 2026 Santhosh — MIT License
# =============================================================================

# ── Python Cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual Environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Model Weights (Large Binary Files) ───────────────────────────────────────
weights/*.pth
weights/*.ckpt
weights/*.bin
weights/*.safetensors
weights/*.pt
# Keep the README describing how to download weights
!weights/README.md

# ── Raw Datasets & Processed Outputs (Large Geospatial Files) ────────────────
data/raw/*
data/processed/*
# Keep the directory structure placeholder files
!data/raw/.gitkeep
!data/processed/.gitkeep

# Legacy data/ and outputs/ folders
data/*.tif
data/*.tiff
data/**/*.tif
data/**/*.tiff
outputs/
*.tif
*.tiff
*.geotiff
*.img
*.hdf
*.nc
*.jp2

# ── Secrets & Environment Configuration ──────────────────────────────────────
.env
.env.*
*.secret
secrets/
credentials.json

# ── IDE & Editor Config ───────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ── OS Artifacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Testing & Coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Ray Distributed Compute ───────────────────────────────────────────────────
/tmp/ray/
ray_results/

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
